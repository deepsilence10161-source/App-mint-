<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Splash (Android 12+ SplashScreen API) -->
    <style name="Theme.AppKaro" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/brand</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/Theme.AppKaroMain</item>
    </style>

    <!-- Main: framework Material, edge-to-edge friendly -->
    <style name="Theme.AppKaroMain" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="android:windowBackground">@android:color/white</item>
    </style>
</resources>
