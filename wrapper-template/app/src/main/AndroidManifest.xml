<?xml version="1.0" encoding="utf-8"?>
<!--
  ⚡ AppKaro wrapper manifest — audit-proof defaults:
  · allowBackup=false            (AppMint bug: backup leak)
  · cleartext server-configured  (AppMint bug: हमेशा खुला)
  · EXTRA_PERMISSIONS marker     (CI build-time पर इन्सert करता है — least privilege)
  · predictive back enabled
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- EXTRA_PERMISSIONS -->

    <application
        android:name=".App"
        android:label="${appLabel}"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/Theme.AppKaro"
        android:allowBackup="false"
        android:usesCleartextTraffic="${cleartextTraffic}"
        android:supportsRtl="true"
        android:hardwareAccelerated="true"
        android:enableOnBackInvokedCallback="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 💰 AdMob app id — CI placeholder से (खाली हो तो SDK link ही नहीं होता, tag inert) -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="${adsAppId}" />
    </application>
</manifest>
